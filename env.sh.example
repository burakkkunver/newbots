# Bu dosyayı env.sh adıyla kopyala ve tırnakların içini doldur:  cp env.sh.example env.sh && nano env.sh
export BINANCE_API_KEY=""        # testnet.binance.vision'dan alınan TESTNET anahtarı
export BINANCE_SECRET=""
export GEMINI_API_KEY=""         # aistudio.google.com -> faturalandırması açık projenin anahtarı
export TELEGRAM_BOT_TOKEN=""
export TELEGRAM_CHAT_ID=""
export TEST_MODE="True"          # True = Binance Testnet (sahte para). False = GERÇEK hesap!

# ---- İsteğe bağlı ayarlar (boş bırakırsan varsayılanlar kullanılır) ----
export BUDGET_USDT="100"         # Botun kullanacağı bütçe (testnette cüzdanda 10.000$ olsa bile)
export SUMMARY_MINUTES="20"      # Telegram özet sıklığı (dakika)
export REPORT_HOUR="23"          # Gece raporu saati (Türkiye saati)
